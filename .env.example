# Скопируйте этот файл в .env и впишите свой ключ.
# Ключ также подхватывается напрямую из окружения (ANTHROPIC_API_KEY)
# или из профиля `ant auth login` — тогда .env не обязателен.

ANTHROPIC_API_KEY=sk-ant-...

# Необязательные переопределения (можно задать и флагами CLI):
# DISCOVERY_MODEL=claude-opus-5
# DISCOVERY_EFFORT=high
# DISCOVERY_MAX_TOKENS=32000
